# =====================================================================
# DHRUVA Environment Configuration Template
# Copy this file to .env and configure your secret keys.
# =====================================================================

# 1. Google Gemini API (Required for Voice Assistant & Live Streaming)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview

# 2. OpenRouteService (Required for Driving & Walking Transit Matrices)
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.openrouteservice.org
ORS_PROFILE=driving-car
ORS_TIMEOUT_SECONDS=10.0

# 3. PostgreSQL Database (Optional for Production DB Server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhruva_db

# 4. Supabase (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 5. Server Debug Mode
DEBUG=false
