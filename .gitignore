# =====================================================================
# DHRUVA - Comprehensive .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. Python & Bytecode
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
develop-eggs/
downloads/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------
# 2. Environment Variables & Secrets
# ---------------------------------------------------------------------
.env
.env.*
*.env
scraper/**/.env
backend/**/.env
!.env.example
!.env.template

# ---------------------------------------------------------------------
# 3. Scraper Artifacts, Checkpoints & Geocache
# ---------------------------------------------------------------------
.checkpoint.json
.geocache.json
**/.checkpoint.json
**/.geocache.json
data/scraped/.checkpoint.json
data/scraped/.geocache.json
*.cache
.cache/
logs/
*.log

# ---------------------------------------------------------------------
# 4. Database Temporary & Lock Files
# ---------------------------------------------------------------------
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.bak
*.backup
*.dump

# ---------------------------------------------------------------------
# 5. Frontend & Node (Future Proofing)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# ---------------------------------------------------------------------
# 6. IDEs & Code Editors
# ---------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text & Editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# ---------------------------------------------------------------------
# 7. Operating System Files
# ---------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------------
# 8. Local AI / Agent Settings & Session State
# ---------------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
